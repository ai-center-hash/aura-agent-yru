# คัดลอกเป็น .env แล้วแก้ค่า (.env ห้าม commit)

# LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434      # ผ่าน SSH tunnel ไป 10.20.41.54
# LLM_BASE_URL=                             # ใช้เมื่อ LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen3.6:35b-a3b
LLM_TEMPERATURE=0.2
LLM_THINK=false
LLM_NUM_CTX=16384

# Activity API (ข้อมูลจริง)
ACT_API_BASE_URL=https://api831.yru.ac.th/act/api
ACT_API_TIMEOUT_S=15

# ยืนยันตัวตน (passport = ถาม YRU Passport แล้วเรียกเส้น public, activity_me = ใช้ /summary/me)
IDENTITY_MODE=passport
PASSPORT_BASE_URL=https://passport.yru.ac.th
PASSPORT_TIMEOUT_S=10
# OAuth client สำหรับหน้าแชททดสอบ (scripts/dev_chat.py) — ขอได้จาก YRU Passport
# PASSPORT_CLIENT_ID=
# PASSPORT_CLIENT_SECRET=
# PASSPORT_REDIRECT_URI=http://127.0.0.1/callback

# Service
SERVICE_KEY=change-me-to-a-random-string-at-least-32-chars
CHECKPOINTER=sqlite
SQLITE_PATH=./data/aura.sqlite
CACHE=memory
LOG_LEVEL=INFO
EXPOSE_DOCS=false                           # true = เปิด /docs (เฉพาะเครื่องผู้พัฒนา)
TIMEZONE=Asia/Bangkok
